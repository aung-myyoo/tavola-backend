spring.application.name=TavolaBackend

server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/tavola?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${DB_USERNAME:your_db_username}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate creates/updates tables from the @Entity classes below.
# Good for learning; a real project would use versioned migrations (Flyway/Liquibase) instead.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Set a random secret via the JWT_SECRET env var in any real deployment.
app.jwt.secret=${JWT_SECRET:change-me-generate-a-long-random-secret}
app.jwt.expiration-minutes=720

app.upload-dir=uploads
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
